[Unit]
Description=Backup interface and scheduler for AMP instance %i
Documentation=https://github.com/GeraldHofbauerWeb/better-amp-backup
After=ampinstmgr.service network-online.target
Wants=network-online.target
# The socket is created by systemd as root and inherited on startup, so that
# nginx can reach it without the daemon leaving the amp user.
Requires=amp-bb-web@%i.socket
After=amp-bb-web@%i.socket

[Service]
Type=simple
# The instances belong to this user already; the daemon needs no more access
# than they have, and specifically not root. That is also why it keeps its own
# schedule rather than rewriting a timer it could not reload.
User=amp
Group=amp
EnvironmentFile=/etc/better-amp-backup/common.env
EnvironmentFile=/etc/better-amp-backup/%i.env
EnvironmentFile=-/etc/better-amp-backup/%i.web.env
ExecStart=/opt/better-amp-backup/bin/amp-bb serve --instance %i --root ${AMPBB_ROOT}
Restart=on-failure
RestartSec=5

# The directory the socket lives in is traversable by everyone; the socket in
# it is not. The settings and the run history are ours alone.
RuntimeDirectory=better-amp-backup
RuntimeDirectoryMode=0755
StateDirectory=better-amp-backup
StateDirectoryMode=0750

# A backup must not slow down the server it is backing up.
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# The repository it writes. The instance directory -- which a restore writes
# into -- is added by a per-instance drop-in that the installer generates,
# because systemd does not expand environment variables in this setting: it
# reports "path is not absolute, ignoring" and carries on, and the symptom
# would be a restore dying with EROFS in production.
#
# ReadWritePaths does take precedence over ProtectHome=read-only; that part was
# checked with systemd-run rather than assumed.
ReadWritePaths=/opt/better-amp-backup/repo

[Install]
WantedBy=multi-user.target
